    -- Triggerbot & Auto-Reload
    task.spawn(function()
        while task.wait(0.1) do
            if Config.Triggerbot and LocalPlayer.Character then
                local ray = Camera:ScreenPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                local params = RaycastParams.new()
                params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                params.FilterType = Enum.RaycastFilterType.Exclude
                local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
                if hit and hit.Instance then
                    local model = hit.Instance:FindFirstAncestorOfClass("Model")
                    if model and model:FindFirstChild("Humanoid") then
                        local targetPlayer = Players:GetPlayerFromCharacter(model)
                        if targetPlayer and IsEnemy(targetPlayer) and model.Humanoid.Health > 0 then
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                            task.wait(0.02)
                            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                            task.wait(0.15)
                        end
                    end
                end
            end
            if Config.AutoReload and LocalPlayer.Character then
                pcall(function()
                    if LocalPlayer.PlayerGui.GUI.Client.Variables.ammo.Value == 0 then
                        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
                        task.wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
                        task.wait(1.5)
                    end
                end)
            end
        end
    end)

    -- Main Render Loop
    local lastTime, frameCount = tick(), 0
    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local currentTime = tick()
        if currentTime - lastTime >= 1 then
            local ping = 0
            pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
            
            local kills, deaths = 0, 0
            pcall(function() 
                if LocalPlayer:FindFirstChild("leaderstats") then
                    kills = LocalPlayer.leaderstats:FindFirstChild("Kills") and LocalPlayer.leaderstats.Kills.Value or 0
                    deaths = LocalPlayer.leaderstats:FindFirstChild("Deaths") and LocalPlayer.leaderstats.Deaths.Value or 0
                end
            end)
            
            local mapName = workspace:FindFirstChild("Map") and workspace.Map.Name or "Unknown"

            DashStats:Set({
                Title = "Live Telemetry",
                Content = string.format("FPS: %d\nPing: %d ms\nPlayers: %d / %d\nSession Time: %s\nMap: %s\nKills: %d | Deaths: %d", 
                    frameCount, ping, #Players:GetPlayers(), Players.MaxPlayers, FormatTime(currentTime - ScriptStartTime), mapName, kills, deaths)
            })

            DashStatus:Set({
                Title = "Feature Status",
                Content = string.format("Aimbot: %s\nESP: %s\nMovement Mods: %s\nFlight: %s\nSpinbot: %s\nNoclip: %s", 
                    tostring(Config.AimbotEnabled), tostring(Config.ESPEnabled), tostring(Config.MovementMod), tostring(Config.FlyEnabled), tostring(Config.Spinbot), tostring(Config.Noclip))
            })

            frameCount, lastTime = 0, currentTime
        end

        -- Viewmodel Skin & Arm Customizer
        if Config.CustomWeaponSkin or Config.CustomArmSkin then
            local arms = Camera:FindFirstChild("Arms")
            if arms then
                for _, item in ipairs(arms:GetDescendants()) do
                    if item:IsA("BasePart") or item:IsA("MeshPart") then
                        if item.Name:lower():find("arm") or item.Name:lower():find("hand") or item.Name:lower():find("glove") then
                            if Config.CustomArmSkin then
                                item.Color = Config.ArmColor
                                item.Material = Enum.Material[Config.ArmMaterial] or Enum.Material.ForceField
                            end
                        else
                            if Config.CustomWeaponSkin then
                                item.Color = Config.WeaponColor
                                item.Material = Enum.Material[Config.WeaponMaterial] or Enum.Material.Neon
                            end
                        end
                    end
                end
            end
        end

        -- Aimlock & Spinbot
        if Config.AimbotEnabled and Config.Aiming then
            local target = GetClosestEnemy()
            if target and target.Character and target.Character:FindFirstChild(Config.AimPart) then
                local targetPos = target.Character[Config.AimPart].Position
                if Config.SmoothAim then
                    Camera.CFrame = Camera.CFrame:Lerp(CFrame.lookAt(Camera.CFrame.Position, targetPos), Config.Smoothness)
                else
                    Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
                end
            end
        end

        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local hrp = LocalPlayer.Character.HumanoidRootPart
            local hum = LocalPlayer.Character.Humanoid

            if Config.Spinbot then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(Config.SpinSpeed), 0)
            end

            if Config.MovementMod then
                hum.UseJumpPower = true
                hum.WalkSpeed = Config.WalkSpeed
                hum.JumpPower = Config.JumpPower
            end

            if Config.Bhop and hum.FloorMaterial ~= Enum.Material.Air then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end

            if Config.Noclip then
                for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end

            if Config.FlyEnabled then
                hum.PlatformStand = true
                local bv = hrp:FindFirstChild("KudasaiFlight")
                if not bv then
                    bv = Instance.new("BodyVelocity")
                    bv.Name = "KudasaiFlight"
                    bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                    bv.Parent = hrp
                end

                local moveDir = Vector3.new(0, 0, 0)
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
                bv.Velocity = moveDir * Config.FlySpeed
            else
                hum.PlatformStand = false
                if hrp:FindFirstChild("KudasaiFlight") then hrp.KudasaiFlight:Destroy() end
            end
        end

        -- ESP & Hitboxes
        for _, player in ipairs(Players:GetPlayers()) do
            if IsEnemy(player) and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Head") and player.Character.Humanoid.Health > 0 then
                
                if Config.HitboxExpander then
                    player.Character.Head.Size = Vector3.new(Config.HitboxSize, Config.HitboxSize, Config.HitboxSize)
                    player.Character.Head.Transparency = 0.6
                    player.Character.Head.CanCollide = false
                else
                    player.Character.Head.Size = Vector3.new(1.2, 1, 1)
                    player.Character.Head.Transparency = 0
                end

                if Config.ESPEnabled then
                    local rootPart = player.Character.HumanoidRootPart
                    local dist = (Camera.CFrame.Position - rootPart.Position).Magnitude
                    
                    if dist <= Config.ESPMaxDist then
                        local boxName = player.Name .. "_Box"
                        local existingBox = ESPFolder:FindFirstChild(boxName)
                        
                        if Config.ESPBoxes or Config.ESPNames or Config.ESPHealth or Config.ESPDistance then
                            if not existingBox then
                                local billboard = Instance.new("BillboardGui")
                                billboard.Name = boxName
                                billboard.Adornee = rootPart
                                billboard.Size = UDim2.new(4, 0, 5.5, 0)
                                billboard.AlwaysOnTop = true
                                
                                local frame = Instance.new("Frame", billboard)
                                frame.Size = UDim2.new(1, 0, 1, 0)
                                
                                local text = Instance.new("TextLabel", frame)
                                text.Name = "InfoLabel"
                                text.BackgroundTransparency = 1
                                text.Position = UDim2.new(0, 0, -0.3, 0)
                                text.Size = UDim2.new(1, 0, 0.3, 0)
                                text.TextColor3 = Color3.fromRGB(255, 255, 255)
                                text.TextStrokeTransparency = 0
                                text.TextScaled = true
                                
                                billboard.Parent = ESPFolder
                                existingBox = billboard
                            end
                            
                            existingBox.Frame.BackgroundTransparency = Config.ESPBoxes and 1 or 1
                            existingBox.Frame.BorderSizePixel = Config.ESPBoxes and 1 or 0
                            existingBox.Frame.BorderColor3 = Config.ESPColor
                            
                            local infoString = ""
                            if Config.ESPNames then infoString = infoString .. player.Name .. "\n" end
                            if Config.ESPDistance then infoString = infoString .. "[" .. math.floor(dist) .. "s] " end
                            if Config.ESPHealth then infoString = infoString .. "[HP: " .. math.floor(player.Character.Humanoid.Health) .. "]" end
                            existingBox.Frame.InfoLabel.Text = infoString
                            existingBox.Frame.InfoLabel.TextColor3 = Config.ESPColor
                        elseif existingBox then
                            existingBox:Destroy()
                        end

                        local chamName = player.Name .. "_Cham"
                        local existingCham = ESPFolder:FindFirstChild(chamName)
                        if Config.ESPChams then
                            if not existingCham then
                                local highlight = Instance.new("Highlight")
                                highlight.Name = chamName
                                highlight.Adornee = player.Character
                                highlight.Parent = ESPFolder
                                existingCham = highlight
                            end
                            existingCham.FillColor = Config.ESPColor
                            existingCham.OutlineColor = Color3.new(1,1,1)
                            existingCham.FillTransparency = 0.5
                        elseif existingCham then
                            existingCham:Destroy()
                        end

                        local tracerName = player.Name .. "_Tracer"
                        local existingTracer = TracerGui:FindFirstChild(tracerName)
                        if Config.ESPTracers then
                            local rootPos, onScreen = Camera:WorldToViewportPoint(rootPart.Position - Vector3.new(0, 3, 0))
                            if onScreen then
                                if not existingTracer then
                                    existingTracer = Instance.new("Frame")
                                    existingTracer.Name = tracerName
                                    existingTracer.AnchorPoint = Vector2.new(0.5, 0.5)
                                    existingTracer.BorderSizePixel = 0
                                    existingTracer.Parent = TracerGui
                                end
                                local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                                local targetPos = Vector2.new(rootPos.X, rootPos.Y)
                                local distance = (targetPos - screenBottom).Magnitude
                                local angle = math.deg(math.atan2(targetPos.Y - screenBottom.Y, targetPos.X - screenBottom.X))

                                existingTracer.BackgroundColor3 = Config.ESPColor
                                existingTracer.Size = UDim2.new(0, distance, 0, 1)
                                existingTracer.Position = UDim2.new(0, (screenBottom.X + targetPos.X) / 2, 0, (screenBottom.Y + targetPos.Y) / 2)
                                existingTracer.Rotation = angle
                                existingTracer.Visible = true
                            elseif existingTracer then
                                existingTracer.Visible = false
                            end
                        elseif existingTracer then
                            existingTracer:Destroy()
                        end
                    else
                        if ESPFolder:FindFirstChild(player.Name .. "_Box") then ESPFolder[player.Name .. "_Box"]:Destroy() end
                        if ESPFolder:FindFirstChild(player.Name .. "_Cham") then ESPFolder[player.Name .. "_Cham"]:Destroy() end
                        if TracerGui:FindFirstChild(player.Name .. "_Tracer") then TracerGui[player.Name .. "_Tracer"]:Destroy() end
                    end
                else
                    if ESPFolder:FindFirstChild(player.Name .. "_Box") then ESPFolder[player.Name .. "_Box"]:Destroy() end
                    if ESPFolder:FindFirstChild(player.Name .. "_Cham") then ESPFolder[player.Name .. "_Cham"]:Destroy() end
                    if TracerGui:FindFirstChild(player.Name .. "_Tracer") then TracerGui[player.Name .. "_Tracer"]:Destroy() end
                end
            else
                if ESPFolder:FindFirstChild(player.Name .. "_Box") then ESPFolder[player.Name .. "_Box"]:Destroy() end
                if ESPFolder:FindFirstChild(player.Name .. "_Cham") then ESPFolder[player.Name .. "_Cham"]:Destroy() end
                if TracerGui:FindFirstChild(player.Name .. "_Tracer") then TracerGui[player.Name .. "_Tracer"]:Destroy() end
                if player.Character and player.Character:FindFirstChild("Head") then
                    player.Character.Head.Size = Vector3.new(1.2, 1, 1)
                    player.Character.Head.Transparency = 0
                end
            end
        end
    end)

    Players.PlayerRemoving:Connect(function(player)
        if ESPFolder:FindFirstChild(player.Name .. "_Box") then ESPFolder[player.Name .. "_Box"]:Destroy() end
        if ESPFolder:FindFirstChild(player.Name .. "_Cham") then ESPFolder[player.Name .. "_Cham"]:Destroy() end
        if TracerGui:FindFirstChild(player.Name .. "_Tracer") then TracerGui[player.Name .. "_Tracer"]:Destroy() end
    end)

    Rayfield:LoadConfiguration()
end


